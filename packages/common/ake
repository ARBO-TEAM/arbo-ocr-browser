#!/usr/bin/env bun

import { app, $ } from "@gutenye/script.js";

// `ake` is symlinked into sibling package dirs; capture the caller's cwd so
// commands run in the invoking package dir, not in common/.
$.cwd(process.cwd());

app.cmd("build", "Build package").add(async () => {
  await $`
    rm -rf build
    bun run tsc --project tsconfig.build.json
    bun run tsc-alias --project tsconfig.build.json
  `;
});

app.cmd("publish", "Publish package").add(async () => {
  // build by scripts.prepublishOnly
  await $`npm publish`;
});
