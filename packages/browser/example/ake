#!/usr/bin/env bun

import { app, $ } from "@gutenye/script.js";

const ENV = process.env;
ENV.DEFAULT_IMAGE_PATH = "/assets/cn-01.jpg";

app.cmd("build:watch", "Build in watch mode").add(async () => {
  await $`chokidar '../../src/**/*.ts' 'web.ts' 'build.ts' -c 'bun run build.ts' --initial`;
});

app.cmd("start", "Build and start server").add(async () => {
  await $`bun run build.ts`;
  await app.invoke('start:prod --header "Cache-Control:no-cache"');
});

app
  .cmd("start:prod", "Serve built files")
  .add("[...args]", "Extra args")
  .add(async (args) => {
    await $`miniserve build -p 3000 --index index.html --verbose ${args}`;
  });
